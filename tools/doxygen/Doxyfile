PROJECT_NAME           = "Release CI Experiments"
OUTPUT_DIRECTORY       = build/docs/doxygen
INPUT                  = native/packages/core/include \
                         native/packages/package_a/include \
                         native/packages/package_b/include \
                         build/docs/native/generated/include
FILE_PATTERNS           = *.h
RECURSIVE               = YES

OPTIMIZE_OUTPUT_FOR_C   = YES
EXTRACT_ALL             = NO
EXTRACT_STATIC          = NO
JAVADOC_AUTOBRIEF       = YES
TYPEDEF_HIDES_STRUCT    = YES

GENERATE_HTML           = NO
GENERATE_LATEX          = NO
GENERATE_XML            = YES
XML_OUTPUT              = xml

QUIET                   = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = FAIL_ON_WARNINGS

ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = YES
