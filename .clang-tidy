---
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  concurrency-*,
  performance-*,
  portability-*
WarningsAsErrors: '*'
HeaderFilterRegex: '.*native.*'
FormatStyle: file
CheckOptions:
  cert-dcl16-c.NewSuffixes: 'L;LL;LU;LLU'
...
